---
/**
 * Press / endorsement logo strip — Figma `Featured` 10563:13076 (1366x167).
 *
 * A credibility bar that sits directly under the hero: two labelled groups of
 * third-party logos separated by a vertical rule. The design draws it STATIC —
 * the live site's auto-scrolling Owl carousel is gone, and with it the reduced-
 * motion and pause-control problems it created. That decision still stands below
 * 768, where each row becomes a swipeable track: it moves only when the visitor
 * moves it, so WCAG 2.2.2 never binds and there is nothing to pause.
 *
 * Drawn geometry (1366 frame)
 * ---------------------------
 *   section  1366x167 · padding 48px block / 96px inline · flex, items-start, gap 32
 *   group 1  742 wide (hug) · padding-right 32 · border-right 1px border-primary
 *            → divider lands at x=838
 *            label → 32 → row of 4 tiles, gap 64: 160+102+128+128 = 518 (+192) = 710
 *   group 2  400 wide (flex:1) · label → 32 → row, space-between, items-start
 *            tiles 100 + 96 + 80 = 276
 *
 * Structure notes
 * ---------------
 * • Each group is a labelled <ul>, not a heading + list, because the labels are
 *   eyebrows ("FEATURED ON:") and not section headings. The list carries the
 *   accessible name via aria-label so the grouping survives for screen readers.
 * • Each logo sits in a FIXED TILE BOX (`.logo-tile`, sized from the per-logo
 *   width/height in the content module) with the bitmap letterboxed inside via
 *   object-contain. That is exactly how Figma composes them — e.g. a 160x16 WSJ
 *   bitmap vertically centred in a 160x30 frame — and it is what makes the row
 *   measure the drawn 710px and the divider land on the drawn x=838. Sizing the
 *   image alone (h-30 w-auto) does NOT do this: the browser uses the bitmap's
 *   own aspect ratio, and the interim WordPress assets are all 180x60, which
 *   collapsed every press tile to 90px wide and pulled the divider ~160px left.
 *
 * Responsive (invented — the Figma is desktop-only)
 * -------------------------------------------------
 * • >=1280: the drawn two-column split, 64px press-row gap, vertical rule.
 *   At 1366 it reproduces the frame exactly (742 / 32 / 400, divider at x=838).
 * • <1280: the two groups STACK, and the vertical rule becomes a horizontal rule
 *   above the second group (24px clear each side = the drawn 48px gap). This is
 *   arithmetic, not taste: the split needs 518 (press tiles) + 192 (3x64 gap) +
 *   32 (padding) + 32 (column gap) + 276 (endorsement tiles) = 1050px of
 *   container, and `container-site` only yields 1078px from 1174px viewport up —
 *   below that the endorsement row wraps. NOTE the spec's own responsive
 *   proposal ("1024-1199: keep the two-column split, press gap 64 -> 40") does
 *   not fit either: it still needs 1093px against 928px available at 1024.
 *   Stacking keeps every tile at its drawn size instead of faking the layout.
 * • <768: tiles drop to 80% (WSJ 128x24, per the spec's own scale-down) and each
 *   row becomes a horizontal TRACK — one row that scrolls, not a row that wraps.
 *   Arithmetic again: at a 390 viewport `container-site` yields 342px, while the
 *   press row needs 414.4px of tiles (128 + 81.6 + 102.4 + 102.4) plus 3x40px of
 *   gap = 534.4px. Short by 192px, it wrapped to two rows of two; it did so at
 *   every width from 320 to 582. Shrinking the tiles to fit instead would need
 *   them at 0.43 scale (0.61 even at a cramped 8px gap) against the drawn 0.8 —
 *   and the endorsement row ALREADY fits at 390, so a shrink-to-fit rule would
 *   scale only the row that overflows and render the press logos at roughly half
 *   the size of the endorsements directly beneath them, inverting the
 *   credibility hierarchy on a trust bar. The tiles keep their drawn size and
 *   the row scrolls. See the <style> block for why there is no autoplay, no
 *   arrows and no scroll-snap. Section padding-block drops 48 -> 32.
 *
 * Known delta from the frame: the section measures 180px tall, not 167px. Figma
 * cap-trims the eyebrow to a 9px box; a real 14/20 line box is 20px, so each
 * group is 11px taller. Reproducing 167 exactly needs `text-box-trim`, which is
 * not safe cross-browser yet, and the spec is explicit that the 32px label gap
 * is the measured value. The gap is left at 32.
 */
import Container from "@primitives/Container.astro";
import Overline from "@primitives/Overline.astro";
import type { LogoStripSection } from "@content/homepage/products";

interface Props {
  block: LogoStripSection;
  class?: string;
}

const { block, class: className = "" } = Astro.props;
---

<section
  id={block.anchorId}
  aria-label={block.label}
  class:list={["border-y border-border-primary bg-bg-secondary", className]}
>
  <Container class="py-md md:py-lg">
    <div class="flex flex-col xl:flex-row xl:items-start xl:gap-md">
      {
        block.groups.map((group, groupIndex) => (
          <div
            class:list={[
              "flex flex-col gap-md",
              groupIndex === 0
                ? /* Group 1 hugs its logos and owns the divider on wide screens. */
                  "xl:shrink-0 xl:border-r xl:border-border-primary xl:pr-md"
                : /* Later groups: horizontal rule when stacked, flexible when side by side. */
                  "mt-sm border-t border-border-primary pt-sm xl:mt-0 xl:flex-1 xl:border-t-0 xl:pt-0",
            ]}
          >
            <Overline>{group.label}</Overline>

            {/*
              Below 768 each row becomes a horizontal TRACK (see the <style>
              block). `tabindex="0"` ships here rather than being added by the
              script because the fail-safe direction matters: no logo has an
              href yet (TODO(client) in products.ts), so this strip contains
              ZERO focusable elements, and a scrolling row with nothing
              focusable inside it puts press logos 3 and 4 out of keyboard
              reach entirely — WCAG 2.1.1 Level A, and axe's
              `scrollable-region-focusable`. With JS off the correct state is
              "reachable, with a spare tab stop", not "unreachable". The script
              below removes it wherever it is not needed, so no dead tab stop
              ever reaches the >=768 page.
              It sits on the <ul>, not a wrapper: the <ul> already carries
              role="list" + aria-label, so this needs no new element and no
              duplicated announcement (a wrapper with the same aria-label
              announces the name twice — group "Featured on:" containing list
              "Featured on:").
            */}
            <ul
              aria-label={group.label}
              role="list"
              data-logo-track
              tabindex="0"
              class:list={[
                "logo-track flex flex-wrap gap-y-sm",
                groupIndex === 0
                  ? /* Drawn: align-items:center, gap 64. */
                    "items-center gap-x-10 xl:gap-x-xl"
                  : /* Drawn: align-items:flex-start, space-between across 400px —
                       which puts ~62px between tiles, so the gap here is only a
                       wrap floor, not a drawn value. Kept small so the row stays
                       on one line in the 1280-1365 band, where the column is
                       303px rather than the drawn 400px. */
                    "w-full items-start justify-between gap-x-2xs",
              ]}
            >
              {group.logos.map((logo) => {
                const decorative = logo.image.decorative === true;
                const tile = `--tile-w:${logo.image.width}px;--tile-h:${logo.image.height}px`;
                const img = (
                  <img
                    src={logo.image.src}
                    alt={decorative ? "" : logo.image.alt}
                    aria-hidden={decorative ? "true" : undefined}
                    width={logo.image.width}
                    height={logo.image.height}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                );
                return (
                  <li class="flex items-center">
                    {logo.href ? (
                      <a
                        href={logo.href}
                        rel="noopener noreferrer"
                        target="_blank"
                        class="logo-tile opacity-100 transition-opacity duration-150 hover:opacity-70 motion-reduce:transition-none"
                        style={tile}
                      >
                        {img}
                      </a>
                    ) : (
                      <span class="logo-tile" style={tile}>
                        {img}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<style>
  /*
    The Figma tile box, per logo. Width/height come from the content module as
    custom properties so the tiles stay data-driven (they are NOT uniform:
    160/102/128/128 and 100/96/80). Below 768 every tile scales to 80% — the
    scale-down the spec itself proposes (WSJ 160x30 -> 128x24).
  */
  .logo-tile {
    display: block;
    flex: none;
    width: calc(var(--tile-w) * 0.8);
    height: calc(var(--tile-h) * 0.8);
  }

  @media (width >= 768px) {
    .logo-tile {
      width: var(--tile-w);
      height: var(--tile-h);
    }
  }

  /*
    MOBILE (<768): each row is a horizontal TRACK, not a wrapping row.

    WHY A TRACK AND NOT SMALLER TILES — measured, not assumed. Fitting group 1
    on one row at 390 needs the tiles at s = (342 - 3*gap)/518: 0.43 at the
    current 40px gap, and still only 0.61 even at a cramped 8px gap, against
    today's 0.80. The decisive part is that group 2 ALREADY FITS at 390, so a
    shrink-to-fit rule would scale only the row that overflows and render the
    press logos at roughly half the size of the endorsements directly beneath
    them — inverting the credibility hierarchy on a trust bar. (It also drops
    INQUIRER.NET, the flattest mark, below the 9px cap height of its own
    "FEATURED ON:" label.) The tiles stay at the drawn 0.8 and the row scrolls.

    THIS IS NOT THE LIVE SITE'S OWL CAROUSEL. Nothing moves on its own, so
    WCAG 2.2.2 never binds, there is no pause control to ship, and there is no
    JS scroll animation to gate — the static decision recorded at the top of
    this file still stands. There are deliberately no arrows and no dots: four
    controls for seven logos is exactly the chrome NewsGrid, ContactSection and
    SocialFeed each refused in writing, and 44px targets would dominate a 24px
    row. The partially clipped tile at the container gutter IS the affordance.

    NO SCROLL-SNAP, deliberately. Each tile is a fixed letterbox with the
    bitmap centred inside via object-contain, so a tile boundary is not a
    visible edge — snapping would align to nothing the eye can see, and with
    seven irregular widths there is no card unit to snap to. It would also
    fight the browser's own focus-scroll once the href TODO(client) lands.

    Gated on 768, the same seam the .logo-tile scale-down above uses, so this
    component has one mobile breakpoint. It is a deliberate no-op from 583 up,
    where the row already fits (verified pixel-identical at 583/640/767); it
    only bites below 583, where group 1 actually wrapped to two rows.
  */
  @media (width < 768px) {
    .logo-track {
      /* These three OVERRIDE Tailwind utilities on the same element
         (flex-wrap, and w-full + justify-between on group 2). Astro's scoped
         <style> is UNLAYERED while Tailwind's utilities live in
         `@layer utilities`, so this block wins on layer order regardless of
         specificity. Verified — do NOT "fix" it with !important, and do not
         delete the utilities from the markup: they are what restores the
         drawn layout at >=768. */
      flex-wrap: nowrap;
      /* Group 2 carries `w-full`. A definite width defeats the cross-axis
         stretch and leaves its track a different width from group 1's, so the
         two rows clip at different edges. */
      width: auto;
      justify-content: flex-start;

      overflow-x: auto;
      /* Stop a swipe at scrollLeft 0 from chaining into browser
         back-navigation. x only, so a vertical wheel over the strip still
         scrolls the page normally. */
      overscroll-behavior-x: contain;

      /* Both groups must read as one component. Group 2 is `justify-between`
         on a full-width row; inside a scroll container that pins its first and
         last tile to the content-box edges and leaves its 8px gap doing
         nothing. Below 768 both rows therefore use group 1's 40px gap and
         start alignment. 40px is matched to group 1's existing `gap-x-10` —
         if that changes, change this with it. It is deliberately NOT reduced
         to a token value: 24px and 32px were measured and both destroy the
         peek at the common 412/414/428/430 device widths, where 40px keeps
         74-92px of the next tile visible. */
      column-gap: 40px;

      /* overflow-x:auto forces overflow-y to compute to `auto`, which would
         clip a focused tile's 2px ring at its 2px offset inside a 24px-tall
         box. 4px of padding gives the ring room; the equal negative margin
         cancels it, so the section height is unchanged (measured 267/311/180,
         identical to baseline). */
      padding-block: 4px;
      margin-block: -4px;

      /* Same idiom as PriceTicker.astro:35. A classic scrollbar under a 24px
         logo row would out-shout the logos. The remaining routes to the
         content are swipe, trackpad/horizontal wheel, and arrow keys on the
         focused track — which is what the tabindex above is for. */
      scrollbar-width: none;
    }

    .logo-track::-webkit-scrollbar {
      display: none;
    }

    /* A scroll container clips at its padding box, so once the href
       TODO(client) lands and the tiles become links, draw the focus ring
       inside — the same fix, for the same reason, as FaqAccordion.astro:166. */
    .logo-track a.logo-tile:focus-visible {
      outline-offset: -2px;
    }
  }
</style>

<script>
  /*
    A scroll container that actually overflows must be reachable by keyboard
    (WCAG 2.1.1 / axe `scrollable-region-focusable`). The tabindex ships in the
    markup and is removed here, not the other way round: without JS the correct
    state is "reachable with a spare tab stop", not "logos 3 and 4 unreachable".

    It is removed in two cases — the row fits (so the static rows at >=768 never
    become dead tab stops, and neither does the 583-767 band), or the track
    already contains something focusable (once the logos get their hrefs the
    <a>s carry keyboard access and the container should stop being a tab stop
    of its own). This is what keeps the >=768 accessibility tree unchanged.
  */
  const tracks = document.querySelectorAll<HTMLElement>("[data-logo-track]");

  if (tracks.length) {
    const sync = (el: HTMLElement) => {
      /* +1 absorbs sub-pixel rounding: at 582 the row is 534.375px of content
         in a 534px box, which is not real overflow. */
      const scrollable = el.scrollWidth > el.clientWidth + 1;
      const focusable = el.querySelector(
        "a[href], button, [tabindex]:not([tabindex='-1'])",
      );
      if (scrollable && !focusable) el.setAttribute("tabindex", "0");
      else el.removeAttribute("tabindex");
    };

    /* ResizeObserver rather than a resize listener: it fires on the element's
       own box, which covers viewport resize, orientation change AND the 768
       seam where both the container padding and the tile scale change at once.
       Mutating tabindex has no layout effect, so it cannot loop. */
    const observer = new ResizeObserver((entries) => {
      entries.forEach((entry) => sync(entry.target as HTMLElement));
    });

    tracks.forEach((el) => {
      sync(el);
      observer.observe(el);
    });
  }
</script>
