---
/**
 * Press / endorsement logo strip — Figma `Featured` 10563:13076 (1366x167).
 *
 * A credibility bar that sits directly under the hero: two labelled groups of
 * third-party logos separated by a vertical rule.
 *
 * AUTO-SCROLL. The Figma frame draws the strip static with four press logos.
 * The client asked for the live site's set — eight — and for the live site's
 * behaviour, so a row that does not fit its column scrolls itself, continuously
 * and in one direction, and there are no arrow buttons. A row that DOES fit
 * (the three endorsements) does not move at all: animating a row with nothing
 * to reveal is motion for its own sake.
 *
 * How the loop is seamless: the row is rendered twice inside a `max-content`
 * flex box and translated by exactly one row-plus-gap, so the moment the copy
 * reaches the original's start position the animation restarts on an identical
 * frame. The clone is `aria-hidden` and carries no alt text, so assistive tech
 * reads eight logos, not sixteen. The shift and the duration are set from the
 * measured row width by the script — a percentage cannot express it, because
 * 50% of (2 x row + gap) is half a gap short of the seam.
 *
 * Drawn geometry (1366 frame)
 * ---------------------------
 *   section  1366x167 · padding 48px block / 96px inline · flex, items-start, gap 32
 *   group 1  742 wide · padding-right 32 · border-right 1px border-primary
 *            → divider lands at x=838
 *            label → 32 → row of tiles, gap 64
 *   group 2  400 wide · label → 32 → row, space-between, items-start
 *            tiles 100 + 96 + 80 = 276
 *
 * Group 1 takes the REMAINING width rather than hugging its logos: with eight
 * tiles (1316px) hugging would size the column past the viewport. Group 2 holds
 * the drawn 400, so 1174 − 400 − 32 leaves group 1 the drawn 742 and the divider
 * still lands on x=838.
 *
 * Structure notes
 * ---------------
 * • Each group is a labelled <ul>, not a heading + list, because the labels are
 *   eyebrows ("FEATURED ON:") and not section headings. The list carries the
 *   accessible name via aria-label so the grouping survives for screen readers.
 * • Each logo sits in a FIXED TILE BOX (`.logo-tile`, sized from the per-logo
 *   width/height in the content module) with the bitmap letterboxed inside via
 *   object-contain. That is exactly how Figma composes them — e.g. a 160x16 WSJ
 *   bitmap vertically centred in a 160x30 frame. Sizing the image alone
 *   (h-30 w-auto) does NOT do this: the browser uses the bitmap's own aspect
 *   ratio, and the interim WordPress assets are all 180x60, which collapsed
 *   every press tile to 90px wide and pulled the divider ~160px left.
 *
 * MOTION AND ACCESSIBILITY — read before changing the animation
 * -------------------------------------------------------------
 * • `prefers-reduced-motion: reduce` gets NO animation and no clipping: the row
 *   wraps instead, so every logo is on screen at once. That is the branch that
 *   makes the auto-scroll safe for vestibular disorders, and it is also the only
 *   branch where the strip is taller than one row.
 * • The animation pauses on hover and on `:focus-within`, so it stops for a
 *   pointer user reading a mark and for a keyboard user who tabs into the strip
 *   once the logos get their hrefs (TODO(client) in products.ts).
 * • KNOWN GAP, deliberate and the client's call: WCAG 2.2.2 (Pause, Stop, Hide)
 *   wants a mechanism to stop motion that runs longer than five seconds. Hover
 *   and focus are mechanisms, but neither is available to a visitor on a touch
 *   screen who is not motion-sensitive enough to have set the OS flag. A visible
 *   pause control would close it; the client asked for no buttons on this strip.
 *   The live site has the same gap with none of the mitigations.
 * • Nothing here traps a scroll: the marquee clips (`overflow: hidden`) rather
 *   than scrolls, so there is no scrollable region needing a tab stop, and no
 *   WCAG 2.1.1 / `scrollable-region-focusable` obligation. That is why the
 *   `tabindex` dance an earlier version of this component carried is gone.
 *
 * Responsive (invented — the Figma is desktop-only)
 * -------------------------------------------------
 * • >=1280: the drawn two-column split with the vertical rule.
 * • <1280: the groups STACK and the rule becomes horizontal above the second
 *   group (24px clear each side = the drawn 48px gap). Arithmetic, not taste:
 *   the split needs more container than `container-site` yields below 1280.
 * • <768: tiles drop to 80% (WSJ 160x30 -> 128x24, the spec's own scale-down)
 *   and the section's padding-block drops 48 -> 32.
 *
 * Known delta from the frame: the section measures 180px tall, not 167px. Figma
 * cap-trims the eyebrow to a 9px box; a real 14/20 line box is 20px, so each
 * group is 11px taller. Reproducing 167 exactly needs `text-box-trim`, which is
 * not safe cross-browser yet, and the spec is explicit that the 32px label gap
 * is the measured value. The gap is left at 32.
 */
import Container from "@primitives/Container.astro";
import Overline from "@primitives/Overline.astro";
import type { LogoStripBlock } from "@content/types";

interface Props {
  /** `label` (the landmark's accessible name) is on the block itself. */
  block: LogoStripBlock;
  class?: string;
}

const { block, class: className = "" } = Astro.props;
---

<section
  id={block.anchorId}
  aria-label={block.label}
  data-block
  data-theme="light"
  data-seam={block.seam}
  class:list={["border-y border-border-primary bg-bg-secondary", className]}
>
  <Container class="py-md md:py-lg">
    <div class="flex flex-col xl:flex-row xl:items-start xl:gap-md">
      {
        block.groups.map((group, groupIndex) => {
          /* Drawn: group 1 centres its tiles on a 64 gap; group 2 spreads three
             marks across the 400 column, which puts ~62px between them — so its
             gap value is only a floor, not a drawn number. */
          const rowClass =
            groupIndex === 0
              ? "items-center gap-x-10 xl:gap-x-xl"
              : "w-full items-start justify-between gap-x-2xs";

          const tiles = group.logos.map((logo) => {
            const decorative = logo.image.decorative === true;
            const tile = `--tile-w:${logo.image.width}px;--tile-h:${logo.image.height}px`;
            const img = (
              <img
                src={logo.image.src}
                alt={decorative ? "" : logo.image.alt}
                aria-hidden={decorative ? "true" : undefined}
                width={logo.image.width}
                height={logo.image.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            );
            return (
              <li class="flex items-center">
                {logo.href ? (
                  <a
                    href={logo.href}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="logo-tile opacity-100 transition-opacity duration-150 hover:opacity-70 motion-reduce:transition-none"
                    style={tile}
                  >
                    {img}
                  </a>
                ) : (
                  <span class="logo-tile" style={tile}>
                    {img}
                  </span>
                )}
              </li>
            );
          });

          return (
            <div
              data-logo-group
              class:list={[
                "flex flex-col gap-md",
                groupIndex === 0
                  ? /* Takes the remaining width and owns the divider. `min-w-0`
                       is what lets a flex item shrink below its content — without
                       it the row never clips, it blows the layout out. */
                    "xl:min-w-0 xl:flex-1 xl:border-r xl:border-border-primary xl:pr-md"
                  : /* Horizontal rule when stacked; the drawn 400px column at xl,
                       which is what keeps `justify-between` meaningful. */
                    "mt-sm border-t border-border-primary pt-sm xl:mt-0 xl:w-[400px] xl:shrink-0 xl:border-t-0 xl:pt-0",
              ]}
            >
              <Overline>{group.label}</Overline>

              <div class="logo-marquee" data-logo-marquee>
                <div class="logo-marquee-inner">
                  <ul aria-label={group.label} role="list" data-logo-row class:list={["logo-row", rowClass]}>
                    {tiles}
                  </ul>

                  {/*
                    The seamless half of the loop. `aria-hidden` and inert to the
                    accessibility tree, so the strip still announces eight logos;
                    it is only ever painted, never read. Rendered always but
                    displayed only once the script confirms the row overflows —
                    a row that fits must not silently double its logos.
                  */}
                  <ul aria-hidden="true" data-logo-clone class:list={["logo-row", rowClass]}>
                    {tiles}
                  </ul>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  /*
    The Figma tile box, per logo. Width/height come from the content module as
    custom properties so the tiles stay data-driven (they are NOT uniform:
    160/110/112/88/128/128/102/40 and 100/96/80). Below 768 every tile scales to
    80% — the scale-down the spec itself proposes (WSJ 160x30 -> 128x24).
  */
  .logo-tile {
    display: block;
    flex: none;
    width: calc(var(--tile-w) * 0.8);
    height: calc(var(--tile-h) * 0.8);
  }

  @media (width >= 768px) {
    .logo-tile {
      width: var(--tile-w);
      height: var(--tile-h);
    }
  }

  /*
    The viewport the row moves behind. It CLIPS rather than scrolls: a scrolling
    container would need a tab stop of its own (WCAG 2.1.1) and would fight the
    animation every time the visitor touched it.
  */
  .logo-marquee {
    overflow: hidden;
  }

  .logo-marquee-inner {
    display: flex;
    /* Default 100% so a row that fits keeps the drawn layout — group 2's
       `w-full justify-between` needs a definite width to spread across. Only a
       row that actually overflows becomes max-content and animates. */
    width: 100%;

    /* THE GAP AT THE SEAM. The row's own `gap-x-*` utility spaces the tiles
       INSIDE each <ul>; it does nothing between the original and the clone, so
       without this the last logo sits flush against the first one — no space at
       all, twice per loop. The value is measured off the row by the script
       rather than restated here, because the row's gap is responsive
       (`gap-x-10 xl:gap-x-xl`) and a second copy of those numbers would drift.

       It also makes the loop correct, not just the spacing. The script shifts
       by `row + gap` on the stated assumption that the inner box is two rows
       and one gap wide. It was two rows and NO gap, so every cycle overshot by
       one gap and the seam jumped. */
    column-gap: var(--logo-gap, 0px);
  }

  .logo-row {
    /* Overrides nothing: the rows are authored without a wrap utility so the
       clipped, pre-script state is a clipped single row rather than a wrapped
       double one — no layout shift when the animation starts. */
    display: flex;
    flex-wrap: nowrap;
  }

  /* A row that fits shows its logos once. */
  [data-logo-clone] {
    display: none;
  }

  [data-overflowing="true"] .logo-marquee-inner {
    width: max-content;
    /* --logo-shift and --logo-duration are measured and set by the script. The
       fallbacks only matter for the frames before it runs, and a 0px shift is
       a still row rather than a wrong one. */
    animation: logo-marquee var(--logo-duration, 30s) linear infinite;
  }

  [data-overflowing="true"] [data-logo-clone] {
    display: flex;
  }

  /* Stop for anyone reading a mark, and for a keyboard visitor once the logos
     become links. */
  [data-overflowing="true"] .logo-marquee:hover .logo-marquee-inner,
  [data-overflowing="true"] .logo-marquee:focus-within .logo-marquee-inner {
    animation-play-state: paused;
  }

  @keyframes logo-marquee {
    to {
      transform: translateX(calc(-1 * var(--logo-shift, 0px)));
    }
  }

  /*
    REDUCED MOTION: no animation, and nothing hidden behind one. The row wraps
    so every logo is on screen at once — the only state in which this strip is
    more than one row tall, and the reason the auto-scroll is safe to ship.
    Ordered after the rules above so it wins at equal specificity without
    !important.
  */
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      overflow: visible;
    }

    .logo-marquee-inner,
    [data-overflowing="true"] .logo-marquee-inner {
      width: 100%;
      animation: none;
    }

    .logo-row {
      flex-wrap: wrap;
      row-gap: 1.5rem;
    }

    [data-overflowing="true"] [data-logo-clone] {
      display: none;
    }
  }
</style>

<script>
  /*
    Measure, then let CSS animate.

    The shift MUST be one row plus one gap, not a percentage: the inner box is
    two rows and one gap wide, so translating -50% lands half a gap short of the
    seam and the loop visibly stutters once per cycle.

    Duration is derived from that distance at a fixed speed, so a row of eight
    logos and a row of three move at the same pace rather than the same tempo.
  */
  const PIXELS_PER_SECOND = 45;

  const groups = document.querySelectorAll<HTMLElement>("[data-logo-group]");

  const measure = (group: HTMLElement) => {
    const marquee = group.querySelector<HTMLElement>("[data-logo-marquee]");
    const row = group.querySelector<HTMLElement>("[data-logo-row]");
    if (!marquee || !row) return;

    /* Compare the row's own content width against the space it has. Read from
       the ROW, not the clipping box: the box is what constrains it. */
    const available = marquee.clientWidth;
    const content = row.scrollWidth;
    /* +1 absorbs sub-pixel rounding, which otherwise reports a row that fits
       exactly as overflowing and animates it by a fraction of a pixel. */
    const overflowing = content > available + 1;

    group.dataset.overflowing = String(overflowing);
    if (!overflowing) return;

    const gap = Number.parseFloat(getComputedStyle(row).columnGap) || 0;
    const shift = content + gap;
    /* Inherited by .logo-marquee-inner, which spends it between the two rows —
       see the note on `column-gap` there. Set from the same reading that feeds
       `shift`, so the distance travelled and the distance drawn cannot
       disagree. */
    marquee.style.setProperty("--logo-gap", `${gap}px`);
    marquee.style.setProperty("--logo-shift", `${shift}px`);
    marquee.style.setProperty("--logo-duration", `${shift / PIXELS_PER_SECOND}s`);
  };

  if (groups.length) {
    /* ResizeObserver rather than a resize listener: it fires on the element's
       own box, which covers viewport resize, orientation change and the 768
       seam where the tile scale changes. Re-measuring only writes custom
       properties and a data attribute, so it cannot feed back into layout. */
    const observer = new ResizeObserver((entries) => {
      entries.forEach((entry) => measure(entry.target as HTMLElement));
    });

    groups.forEach((group) => {
      measure(group);
      observer.observe(group);
    });

    /* Fonts change tile widths, and the row is measured in pixels. */
    document.fonts?.ready.then(() => groups.forEach(measure));
  }
</script>
