---
/**
 * Best-seller product grid — Figma `Product` 9813:5533 (1366x1821).
 *
 * Intro column + seasonal promo banner, then a FLAT six-card grid. The live
 * site's four metal tabs are deliberately gone: metal is now a colour chip on
 * each card, not a filter, so every product is in the DOM for search engines
 * and no JavaScript is needed to read the section.
 *
 * Structure notes
 * ---------------
 * • The heading accent sits mid-string ("Buy *Gold* and Precious Metals"), which
 *   `SectionHeader` cannot express (it appends the accent), so the heading is
 *   composed here from header.heading / headingAccent / headingTail.
 * • Cards are a <ul>; each card's only tab stop is its "Learn more" link. The
 *   card is not a link surface — the design gives no signal that it is, and a
 *   nested/duplicated hit target would be worse than a single explicit one.
 * • The CTA is pinned with `mt-auto` so CTAs stay on a common baseline across a
 *   row when descriptions differ in length. The Figma assumes every description
 *   is exactly three lines; real copy will not be.
 * • The card CTA is written out here instead of using the ArrowLink primitive:
 *   the Figma mark is the 28x28 `Navigations/Arrow Go` circle-arrow, and the
 *   primitive hardcodes a 12x12 chevron. Everything else about the link (button
 *   text style, hover colour, reduced-motion guard) matches the primitive.
 * • Metal chip gradients are the exact Figma values but are NOT Tailwind theme
 *   tokens (global.css is owned elsewhere), so they live in the scoped style
 *   block below. Promote them to `--gradient-metal-*` when global.css is next
 *   touched.
 *
 * Responsive (invented — the Figma is desktop-only)
 * -------------------------------------------------
 * • >=1024: as drawn. 3-up grid, 32px column gap / 64px row gap, intro text and
 *   the 446px banner side by side with a 96px gap. The banner carries no block
 *   padding at this width, so its 136px content stack (52 headline + 4 + 24
 *   subline + 16 + 40 button) centres inside the drawn 185px box exactly. It is
 *   a min-height rather than a fixed height purely as a safety valve for longer
 *   translated copy — at the shipped copy it renders the drawn 185.
 * • 640–1023: 2-up grid; the intro row stacks and the banner goes full width
 *   below the text. Rather than reproduce the banner's three absolutely
 *   positioned layers at an unintended width, the banner is rebuilt as a flex
 *   row (backdrop as a cover layer, product cutout left, text stack right) so it
 *   recomposes at any width instead of clipping.
 * • <640: 1-up cards; the banner's product cutout is dropped and the text stack
 *   centres over the backdrop. Section padding-block drops 96 -> 64.
 * • The "Variants" row truncates with an ellipsis only at >=768, as drawn. Below
 *   that it wraps — truncating at a ~327px column would hide real content. The
 *   full string is exposed as a `title` for the truncated case.
 */
import Container from "@primitives/Container.astro";
import Overline from "@primitives/Overline.astro";
import Button from "@primitives/Button.astro";
import type { ProductGridSection } from "@content/homepage/products";

interface Props {
  block: ProductGridSection;
  class?: string;
}

const { block, class: className = "" } = Astro.props;
const { header, promo, products, badgeLabel, ctaLabel, specLabels, metalLabels } = block;
---

<section
  id={block.anchorId}
  class:list={["bg-bg-secondary py-xl md:py-3xl", className]}
>
  <Container>
    {/* ---- Intro row: text column + seasonal promo banner ---- */}
    <div class="flex flex-col gap-lg lg:flex-row lg:items-center lg:gap-3xl">
      <div class="flex flex-col gap-sm lg:flex-1">
        {header.overline && <Overline tone="red">{header.overline}</Overline>}

        {/* Figma: Playfair Medium on the H2 32/44 token. MEASURED from the
            render, not the spec: "Buy Gold and Precious Metals" sets 427px wide
            in the frame, which is 32px — at 40px the same string sets 534px and
            the heading visibly out-shouts the 20px promo headline beside it.
            `--step-h2` ramps to 40px, so it is capped at the drawn 32 from md up
            and the 44px line box pinned with it. Below md the fluid step (28px
            floor) still runs, since nothing smaller than 1366 is drawn. */}
        <h2 class="text-[length:var(--step-h2)] leading-[1.25] text-text-primary md:text-[2rem] md:leading-[44px]">
          {header.heading}{" "}{
            header.headingAccent && (
              <em class="font-medium italic text-text-tertiary">{header.headingAccent}</em>
            )
          }{" "}{header.headingTail}
        </h2>

        {
          header.body && (
            /* Figma sets the body to the full 632px column (2 lines). The
               65ch cap is only there to stop an over-long measure once the
               intro stacks below lg. */
            <p class="text-base leading-6 text-text-secondary max-lg:max-w-[65ch]">
              {header.body}
            </p>
          )
        }
      </div>

      {
        promo && (
          <div
            class="relative flex items-center justify-between gap-xs overflow-hidden bg-bg-primary p-xs lg:min-h-[185px] lg:w-[446px] lg:shrink-0 lg:gap-0 lg:py-0 lg:pl-0 lg:pr-9"
          >
            {/* Optional decorative backdrop. Every word of the promo is live
                text, so the backdrop must be artwork only — never a
                pre-composited banner with type baked in. */}
            {promo.image && (
              <img
                src={promo.image.src}
                alt=""
                aria-hidden="true"
                width={promo.image.width}
                height={promo.image.height}
                loading="lazy"
                decoding="async"
                class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom"
              />
            )}

            {promo.productImage && (
              <img
                src={promo.productImage.src}
                alt={promo.productImage.decorative ? "" : promo.productImage.alt}
                aria-hidden={promo.productImage.decorative ? "true" : undefined}
                width={promo.productImage.width}
                height={promo.productImage.height}
                loading="lazy"
                decoding="async"
                class="relative hidden w-[38%] max-w-[195px] shrink-0 self-center object-contain sm:block lg:max-h-[160px] lg:w-[195px]"
              />
            )}

            {/* Stack rhythm is MEASURED off the frame, not evenly gapped: the two
                headline lines run at their 26px leading with NO gap between them
                (they read as one two-line headline, not two stacked items), the
                sub-line sits 4px under them, and only the button gets the 16px
                break. Total 52 + 4 + 24 + 16 + 40 = 136, which centres inside the
                drawn 185px box. An even 16px gap throughout makes it 152 and the
                headline stops reading as a single unit. */}
            <div class="relative flex flex-1 flex-col items-center text-center lg:w-[192px] lg:flex-none">
              <p class="flex flex-col font-display text-xl leading-[26px] font-medium text-brand-red capitalize">
                <span>{promo.heading}</span>
                <em class="italic">{promo.headingAccent}</em>
              </p>

              <p class="mt-1 text-base leading-6 italic text-text-secondary">{promo.body}</p>

              {/* Figma draws this button 192x40 with a 14px Playfair label and
                  line-height:normal — it does NOT use the Button 16/24 token
                  (flagged in the spec as a deviation / stale token binding).
                  The primitive is overridden here rather than forked, and the
                  inline padding is reduced so the 24-character label still fits
                  on one line inside the fixed 192px width. */}
              <Button
                href={promo.cta.href}
                variant="solid"
                fullWidth
                external={promo.cta.external}
                class="mt-xs h-10 px-2! py-0! text-sm! leading-normal! capitalize"
              >
                {promo.cta.label}
              </Button>
            </div>
          </div>
        )
      }
    </div>

    {/* ---- Six-card best-seller grid ---- */}
    <ul
      role="list"
      class="mt-lg grid grid-cols-1 gap-x-md gap-y-lg sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-xl"
    >
      {
        products.map((product) => (
          <li class="group flex flex-col gap-sm">
            {/* Image slot: square matte with the best-seller ribbon across the top. */}
            <div class="relative aspect-square overflow-hidden bg-bg-primary">
              {product.bestSeller && badgeLabel && (
                /* Ribbon: full-bleed across the top of the image. Figma draws
                   the bar 24px tall — it pads 8px around a CAP-HEIGHT box (9px
                   for 14px type), not around a line box. A CSS line box is 20px,
                   so keeping the drawn 8px padding renders a 36px bar: half again
                   as deep, and the red band starts competing with the product
                   photo instead of sitting on it. The block padding is therefore
                   2px (2 + 20 + 2 = 24), which lands the cap exactly where the
                   frame does. The label keeps its full 20px line box, so it never
                   clips if the string is translated or a descender appears.
                   Uses the Overline primitive rather than the raw `.overline`
                   class — see the note in the report about the Tailwind name
                   collision. */
                <Overline
                  tone="white"
                  class="absolute inset-x-0 top-0 z-10 bg-brand-red px-3 py-0.5 text-center"
                >
                  {badgeLabel}
                </Overline>
              )}
              <img
                src={product.image.src}
                alt={product.image.decorative ? "" : product.image.alt}
                aria-hidden={product.image.decorative ? "true" : undefined}
                width={product.image.width}
                height={product.image.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain p-[13%] transition-transform duration-300 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
            </div>

            <div class="flex flex-col gap-2xs">
              {/* Title row: name left, metal chip right. */}
              <div class="flex items-center justify-between gap-2xs">
                <h3 class="min-w-0 flex-1 text-[length:var(--step-h3)] leading-7 text-text-primary">
                  {product.name}
                </h3>
                <p class="flex shrink-0 items-center gap-2xs">
                  <span class:list={["metal-chip", `metal-${product.metal}`]} aria-hidden="true" />
                  <span class="text-base leading-6 font-semibold text-text-primary">
                    {metalLabels[product.metal]}
                  </span>
                </p>
              </div>

              {/* Spec block: three rows between hairlines. */}
              <dl class="flex flex-col gap-2xs border-y border-border-primary py-2xs text-base leading-6 text-text-secondary">
                <div class="flex gap-1">
                  <dt class="shrink-0 font-semibold">{specLabels.mint}</dt>
                  <dd class="min-w-0">{product.mint}</dd>
                </div>
                <div class="flex gap-1">
                  <dt class="shrink-0 font-semibold">{specLabels.purity}</dt>
                  <dd class="min-w-0">{product.purity}</dd>
                </div>
                <div class="flex gap-1">
                  <dt class="shrink-0 font-semibold">{specLabels.variants}</dt>
                  <dd class="min-w-0 md:truncate" title={product.variants}>
                    {product.variants}
                  </dd>
                </div>
              </dl>

              <p class="text-base leading-6 text-text-secondary">{product.description}</p>
            </div>

            {/* Pinned to the bottom so CTAs align across a row of uneven cards. */}
            <div class="mt-auto">
              {/* Figma `Button Text` instance: 137x28, 8px gap, BUTTON TEXT in
                  brand-red + the 28x28 `Navigations/Arrow Go/Default` icon (a
                  thin circle outline around a right arrow). The ArrowLink
                  primitive ships a bare 12x12 chevron instead, so the mark is
                  drawn here. TODO(client): promote this icon into ArrowLink once
                  we know whether the other sections use the same `Arrow Go`
                  component — the primitive is owned outside this section. */}
              <a
                href={product.href ?? "#contact"}
                class="group/cta button-text inline-flex items-center gap-2xs text-brand-red transition-colors duration-150 hover:text-brand-950 motion-reduce:transition-none"
              >
                <span>{product.ctaLabel ?? ctaLabel}</span>
                <svg
                  class="h-7 w-7 shrink-0 transition-transform duration-150 group-hover/cta:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover/cta:translate-x-0"
                  viewBox="0 0 28 28"
                  fill="none"
                  aria-hidden="true"
                >
                  {/* The RING is the hairline border colour, NOT the link red.
                      In the frame the red is carried by the label and the arrow
                      only; the circle is a faint 10%-black outline. Drawn in
                      currentColor it reads as a small red button and pulls the
                      eye off the label, so it is stroked with the border token
                      and stays grey through the hover colour change. r=13.5 with
                      a 1px stroke puts the ring on the pixel grid (outer edge
                      exactly on the 28px box), which is what keeps it a crisp
                      hairline instead of a smeared two-pixel grey. */}
                  <circle cx="14" cy="14" r="13.5" class="stroke-border-primary" stroke-width="1" />
                  <path
                    d="M9 14h10M14.75 9.75 19 14l-4.25 4.25"
                    stroke="currentColor"
                    stroke-width="1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  /*
    Metal chip — 18x18, square (no radius), 135deg gradient.
    Values are exact from Figma. They are not Tailwind theme tokens because
    src/styles/global.css is owned by another process; move them to
    --gradient-metal-* there when it is next edited.
  */
  .metal-chip {
    display: block;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .metal-gold {
    background-image: linear-gradient(135deg, #e8c861 0%, #caa44a 100%);
  }
  .metal-silver {
    background-image: linear-gradient(135deg, #e6e6e6 0%, #b8b8b8 100%);
  }
  .metal-platinum {
    background-image: linear-gradient(135deg, #e8e9eb 0%, #9aa0a8 100%);
  }
  .metal-palladium {
    background-image: linear-gradient(135deg, #cdd0d4 0%, #7d8089 100%);
  }
</style>
