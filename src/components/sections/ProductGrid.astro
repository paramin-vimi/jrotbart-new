---
/**
 * Best-seller product grid — Figma `Product` 9813:5533 (1366x1821).
 *
 * Intro column + seasonal promo banner, then a FLAT six-card grid. The live
 * site's four metal tabs are deliberately gone: metal is now a colour chip on
 * each card, not a filter, so every product is in the DOM for search engines
 * and no JavaScript is needed to read the section.
 *
 * Structure notes
 * ---------------
 * • The heading accent sits mid-string ("Buy *Gold* and Precious Metals"), which
 *   is composed here from header.heading / headingAccent / headingTail (the
 *   h2 is capped at the drawn 32/44 — see the note on it — which is why this
 *   block does not delegate to <SectionHeader>).
 * • `header` is optional: the Buy PM best-seller instance is cards only. With
 *   `header.cta` of style "arrow" the link sits at the heading's right, on one
 *   row ("Often held alongside" → Explore, 11127:23353); any other style
 *   renders a Button under the header text.
 * • Every card is the shared `partials/ProductCard.astro` (a <ul> of <li>s):
 *   one tab stop per card, CTA pinned to the card's baseline, and the link
 *   destination decided by `productHref()` — never a page that is not built.
 * • Metal chip gradients are the `--background-image-metal-*` tokens in
 *   global.css (`bg-metal-gold` etc.), shared with the listing tabs and the
 *   metal cards on the other pages.
 *
 * Responsive (invented — the Figma is desktop-only)
 * -------------------------------------------------
 * • >=1024: as drawn. 3-up grid, 32px column gap / 64px row gap, intro text and
 *   the 446px banner side by side with a 96px gap. The banner carries no block
 *   padding at this width, so its 136px content stack (52 headline + 4 + 24
 *   subline + 16 + 40 button) centres inside the drawn 185px box exactly. It is
 *   a min-height rather than a fixed height purely as a safety valve for longer
 *   translated copy — at the shipped copy it renders the drawn 185.
 * • 640–1023: 2-up grid; the intro row stacks and the banner goes full width
 *   below the text. Rather than reproduce the banner's three absolutely
 *   positioned layers at an unintended width, the banner is rebuilt as a flex
 *   row (backdrop as a cover layer, product cutout left, text stack right) so it
 *   recomposes at any width instead of clipping.
 * • <640: 1-up cards; the banner's product cutout is dropped and the text stack
 *   centres over the backdrop. Section padding-block drops 96 -> 64.
 * • The "Variants" row truncates with an ellipsis only at >=768, as drawn. Below
 *   that it wraps — truncating at a ~327px column would hide real content. The
 *   full string is exposed as a `title` for the truncated case.
 */
import Container from "@primitives/Container.astro";
import Overline from "@primitives/Overline.astro";
import Button from "@primitives/Button.astro";
import ArrowGo from "@primitives/ArrowGo.astro";
import ProductCard from "./partials/ProductCard.astro";
import type { ProductGridSection } from "@content/homepage/products";

interface Props {
  block: ProductGridSection;
  class?: string;
}

const { block, class: className = "" } = Astro.props;
const { header, promo, products, badgeLabel, ctaLabel, specLabels, metalLabels } = block;

/* `header.body` may be one paragraph or several (SectionHeading widening). */
const bodyParagraphs =
  header?.body === undefined ? [] : typeof header.body === "string" ? [header.body] : header.body;

const arrowCta = header?.cta?.style === "arrow" ? header.cta : undefined;
const buttonCta = header?.cta && header.cta.style !== "arrow" ? header.cta : undefined;
const hasIntro = Boolean(header || promo);
---

<section
  id={block.anchorId}
  data-block
  data-theme="light"
  data-seam={block.seam}
  class:list={["bg-bg-secondary py-xl md:py-3xl", className]}
>
  <Container>
    {/* ---- Intro row: text column + seasonal promo banner ---- */}
    {hasIntro && (
    <div class="flex flex-col gap-lg lg:flex-row lg:items-center lg:gap-3xl">
      {header && (
      <div class:list={["flex flex-col gap-sm lg:flex-1", arrowCta && "md:flex-row md:items-center md:justify-between md:gap-md"]}>
        {/* With an arrow CTA the header text and the link share one row
            (11127:23353: heading left, Explore right); the text keeps its own
            stack inside. REVIEW: below md the link drops under the heading. */}
        <div class="flex flex-col gap-sm">
        {header.overline && <Overline tone="red">{header.overline}</Overline>}

        {/* Figma: Playfair Medium on the H2 32/44 token. MEASURED from the
            render, not the spec: "Buy Gold and Precious Metals" sets 427px wide
            in the frame, which is 32px — at 40px the same string sets 534px and
            the heading visibly out-shouts the 20px promo headline beside it.
            `--step-h2` ramps to 40px, so it is capped at the drawn 32 from md up
            and the 44px line box pinned with it. Below md the fluid step (28px
            floor) still runs, since nothing smaller than 1366 is drawn. */}
        <h2 class="text-[length:var(--step-h2)] leading-[1.25] text-text-primary md:text-[2rem] md:leading-[44px]">
          {header.headingRuns
            ? header.headingRuns.map((run) =>
                run.accent ? (
                  <em class="font-medium italic text-text-tertiary">{run.text}</em>
                ) : (
                  run.text
                ),
              )
            : (
              <Fragment>
                {header.heading}{" "}{
                  header.headingAccent && (
                    <em class="font-medium italic text-text-tertiary">{header.headingAccent}</em>
                  )
                }{" "}{header.headingTail}
              </Fragment>
            )}
        </h2>

        {
          bodyParagraphs.map((paragraph) => (
            /* Figma sets the body to the full 632px column (2 lines). The
               65ch cap is only there to stop an over-long measure once the
               intro stacks below lg. */
            <p class="text-base leading-6 text-text-secondary max-lg:max-w-[65ch]">
              {paragraph}
            </p>
          ))
        }

        {buttonCta && (
          <Button
            href={buttonCta.href}
            variant={buttonCta.style === "arrow" ? "solid" : (buttonCta.style ?? "solid")}
            external={buttonCta.external}
            class="self-start"
          >
            {buttonCta.label}
          </Button>
        )}
        </div>

        {arrowCta && (
          <a
            href={arrowCta.href}
            class="group/cta button-text inline-flex shrink-0 items-center gap-2xs self-start text-brand-red transition-colors duration-150 hover:text-brand-950 motion-reduce:transition-none md:self-center"
            {...arrowCta.external ? { rel: "noopener noreferrer", target: "_blank" } : {}}
          >
            <span>{arrowCta.label}</span>
            <ArrowGo class="transition-transform duration-150 group-hover/cta:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover/cta:translate-x-0" />
          </a>
        )}
      </div>
      )}

      {
        promo && (
          <div
            class="relative flex items-center justify-between gap-xs overflow-hidden bg-bg-primary p-xs lg:min-h-[185px] lg:w-[446px] lg:shrink-0 lg:gap-0 lg:py-0 lg:pl-0 lg:pr-9"
          >
            {/* Optional decorative backdrop. Every word of the promo is live
                text, so the backdrop must be artwork only — never a
                pre-composited banner with type baked in. */}
            {promo.image && (
              <img
                src={promo.image.src}
                alt=""
                aria-hidden="true"
                width={promo.image.width}
                height={promo.image.height}
                loading="lazy"
                decoding="async"
                class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom"
              />
            )}

            {promo.productImage && (
              <img
                src={promo.productImage.src}
                alt={promo.productImage.decorative ? "" : promo.productImage.alt}
                aria-hidden={promo.productImage.decorative ? "true" : undefined}
                width={promo.productImage.width}
                height={promo.productImage.height}
                loading="lazy"
                decoding="async"
                class="relative hidden w-[38%] max-w-[195px] shrink-0 self-center object-contain sm:block lg:max-h-[160px] lg:w-[195px]"
              />
            )}

            {/* Stack rhythm is MEASURED off the frame, not evenly gapped: the two
                headline lines run at their 26px leading with NO gap between them
                (they read as one two-line headline, not two stacked items), the
                sub-line sits 4px under them, and only the button gets the 16px
                break. Total 52 + 4 + 24 + 16 + 40 = 136, which centres inside the
                drawn 185px box. An even 16px gap throughout makes it 152 and the
                headline stops reading as a single unit. */}
            <div class="relative flex flex-1 flex-col items-center text-center lg:w-[192px] lg:flex-none">
              <p class="flex flex-col font-display text-xl leading-[26px] font-medium text-brand-red capitalize">
                <span>{promo.heading}</span>
                <em class="italic">{promo.headingAccent}</em>
              </p>

              <p class="mt-1 text-base leading-6 italic text-text-secondary">{promo.body}</p>

              {/* Figma draws this button 192x40 with a 14px Playfair label and
                  line-height:normal — it does NOT use the Button 16/24 token
                  (flagged in the spec as a deviation / stale token binding).
                  The primitive is overridden here rather than forked, and the
                  inline padding is reduced so the 24-character label still fits
                  on one line inside the fixed 192px width. */}
              <Button
                href={promo.cta.href}
                variant="solid"
                fullWidth
                external={promo.cta.external}
                class="mt-xs h-10 px-2! py-0! text-sm! leading-normal! capitalize"
              >
                {promo.cta.label}
              </Button>
            </div>
          </div>
        )
      }
    </div>
    )}

    {/* ---- The card grid (six best sellers on the homepage) ---- */}
    <ul
      role="list"
      class:list={[hasIntro && "mt-lg", "grid grid-cols-1 gap-x-md gap-y-lg sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-xl"]}
    >
      {
        products.map((product) => (
          <ProductCard
            product={product}
            badgeLabel={badgeLabel}
            ctaLabel={ctaLabel}
            specLabels={specLabels}
            metalLabels={metalLabels}
          />
        ))
      }
    </ul>
  </Container>
</section>
