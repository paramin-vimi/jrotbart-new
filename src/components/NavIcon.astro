---
/**
 * Line icons for the mega-menu panels and the utility bar.
 *
 * Drawn to one system: 24×24 box, 1.4 stroke, round caps and joins, no fills.
 * They match the circled-outline treatment already used by the stat and office
 * blocks, so the menu reads as part of the same page rather than a bolted-on
 * component.
 *
 * TODO(assets): the Figma file has a `Navigations/*` icon set on the Icon page
 * and the new design does not draw menu panels at all, so these are ours. Swap
 * for the official set if the client would rather stay on it.
 */

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "" } = Astro.props;

const paths: Record<string, string> = {
  // Utility bar
  mail: "M3 6h18v12H3zM3 7l9 6 9-6",
  account: "M12 11a3 3 0 100-6 3 3 0 000 6zM5 20a7 7 0 0114 0",

  // Services
  exchange: "M4 9h13l-3.5-3.5M20 15H7l3.5 3.5",
  vault: "M4 4h16v16H4zM12 16a4 4 0 100-8 4 4 0 000 8M12 8V5.5M12 18.5V16",
  shipping: "M3 7h11v9H3zM14 10h3.5l3 3.5V16H14zM7 16a1.6 1.6 0 103.2 0 1.6 1.6 0 10-3.2 0M16.5 16a1.6 1.6 0 103.2 0 1.6 1.6 0 10-3.2 0",
  lending: "M2.5 7h19v10h-19zM12 14.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5",
  advisory: "M4 5h16v10H9.5L4 19zM8.5 10h7",
  authenticate: "M12 3l7.5 3v6c0 4.2-3.1 7.3-7.5 8.5C7.6 19.3 4.5 16.2 4.5 12V6zM9 12l2.2 2.2L15.5 10",
  preserve: "M3.5 16.5L9 11l3.2 3.2L20.5 6M20.5 6h-4.5M20.5 6v4.5",
  box: "M3.5 9h17v11h-17zM8 9V6.5a4 4 0 018 0V9M12 13v3",

  // Products — one bullion-bar mark, so the four metals read as a set.
  "bar-gold": "M5.5 15.5h13l-2-7h-9zM8.5 12h7",
  "bar-silver": "M5.5 15.5h13l-2-7h-9zM8.5 12h7",
  "bar-platinum": "M5.5 15.5h13l-2-7h-9zM8.5 12h7",
  "bar-palladium": "M5.5 15.5h13l-2-7h-9zM8.5 12h7",

  // News & Events
  resources: "M6 3.5h7.5L18 8v12.5H6zM13.5 3.5V8H18M9 12h6M9 15.5h6",
  news: "M3.5 6h13v13h-13zM16.5 9.5H20v7a2 2 0 01-3.5 1.4M6.5 9.5h7M6.5 13h7M6.5 16h4",
  events: "M4 6h16v14H4zM8 3.5V8M16 3.5V8M4 11h16",
  press: "M4 10v4l10 4.5V5.5zM14 9.5a3 3 0 010 5M4 14h2.5v4.5",
};

const d = paths[name];
---

{
  d && (
    <svg
      viewBox="0 0 24 24"
      class:list={["h-6 w-6", className]}
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d={d} />
    </svg>
  )
}
