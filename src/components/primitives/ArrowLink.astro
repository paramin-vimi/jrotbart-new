---
/** Figma "Button Text" + arrow. Used for Explore / Read More / Map links. */
interface Props { href: string; class?: string; tone?: "dark" | "light"; external?: boolean }
const { href, class: className = "", tone = "dark", external = false } = Astro.props;
const tones = {
  dark: "text-text-primary hover:text-brand-red",
  light: "text-always-white hover:text-always-white/80",
} as const;
---
<a
  href={href}
  class:list={[
    "group inline-flex items-center gap-2 button-text transition-colors duration-150 motion-reduce:transition-none",
    tones[tone],
    className,
  ]}
  {...external ? { rel: "noopener noreferrer", target: "_blank" } : {}}
>
  <span><slot /></span>
  <svg
    class="h-3 w-3 shrink-0 transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
    viewBox="0 0 12 12" fill="none" aria-hidden="true"
  >
    <path d="M1 6h9M6.5 2l4 4-4 4" stroke="currentColor" stroke-width="1.25"
      stroke-linecap="square" />
  </svg>
</a>
