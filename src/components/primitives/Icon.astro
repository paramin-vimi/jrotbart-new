---
import type { IconName } from "@content/types";

/**
 * The one inline-SVG icon map.
 *
 * Every glyph is drawn inline so it inherits `currentColor` (brand red inside
 * an IconDisc, white on a dark band) and costs no request. 24-unit viewBox,
 * drawn at 28px (`h-7 w-7`) unless the caller says otherwise. Decorative by
 * definition: an icon has no alt text of its own — the cell title, link label
 * or `aria-label` beside it is the accessible name — so it is always
 * `aria-hidden`.
 *
 * Sources. The four AboutStats glyphs (shield-safe, safebox, earth-pin, coin)
 * are the hand-traced paths that component shipped with, kept as-is so the
 * homepage renders identically (TODO(assets): the Figma components are
 * General/Shield Safe 1871:6847, Office/Safebox 1871:6721, Maps/Earth Pin
 * 1871:7386, Finance/Coin 1871:7258). Every other glyph is the Figma
 * component exported once as SVG (GET /v1/images/:key?ids=<id>&format=svg)
 * with its hard-coded #1A1A1A stroke replaced by `currentColor` — the only
 * edit — except where noted:
 *   • `earth` (1871:6851): Figma clips the continents with a <mask>, which
 *     needs a document-unique id; inlined many times that is invalid HTML, so
 *     the mask is dropped and the one continent the mask was hiding (it lies
 *     outside the globe) is omitted instead. Same silhouette.
 *   • `arrow-back` (Navigations/Arrow Back 10369:5850): the component is a
 *     ring + arrow at 28px. The ring belongs to ArrowGo (which also draws it
 *     for the forward arrow); this entry is the bare glyph, mirrored from
 *     ArrowGo's forward arrow at the 24 grid.
 *   • `pin-office` (Jrotbart Office Location 9655:11754) and `linkedin`
 *     (1871:7862) are FILLED shapes, so they carry `fill` and `stroke="none"`
 *     rather than inheriting the stroke set on the <svg>.
 * Stroke widths are the components' own (Figma draws these at 1, the two
 * chevrons at 1.5); the <svg> default of 1.5 applies only to the four
 * hand-traced glyphs, which were drawn for it.
 */
interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "h-7 w-7" } = Astro.props;

const ICONS: Record<IconName, string> = {
