---
/**
 * SiteFooter — Figma node 9813:6346 (instance of a shared Footer component).
 *
 * Desktop geometry (1366 frame, 1174 content column, background always-black):
 *
 *   pt 96
 *   ├ brand lockup                     279.8 × 40
 *   ├ gap 64 (xl)
 *   ├ main row                         1174 × 164, justify-between, items-start
 *   │   ├ sitemap block  640 = 2 × 320 columns, 8px item gap → 32px pitch
 *   │   └ subscribe block 534, 16px stack: OVERLINE / input / consent / social
 *   ├ gap 64 (xl)
 *   └ legal bar                        1174 × 72, 1px top rule, 24px padding-block
 *
 * The footer has no bottom padding of its own — the legal bar's own 24px is the
 * last 24px of the 500px block. That is why the root sets padding-top only.
 *
 * RESPONSIVE DECISIONS WE INVENTED (there is no mobile comp — please review):
 *
 *  1. SITEMAP COLLAPSES TO ONE LIST BELOW 640px. Two 320px columns nominally
 *     fit a 375px screen with 24px gutters, but only just, and "News & Events"
 *     and "Open an account" would wrap mid-label. One 8-item list reads better
 *     and gives every link a full-width target. Two columns return at `sm`.
 *     The 8px item gap is dropped below `sm` — the 44px rows already separate
 *     themselves, and keeping it would add 64px to a footer that is already
 *     the tallest thing on a phone.
 *  2. TAP TARGETS. Every link in the sitemap gets a 44px minimum height below
 *     `sm`, then drops back to the design's exact 24px row at `sm` and up where
 *     a pointer is the likely input. The arrow submit is a 44 × 44 hit area at
 *     every size; the four social marks are 40 × 44. Both are pulled flush to
 *     the content edge with a negative margin, so the glyphs land exactly where
 *     the comp draws them (arrow flush right; social pitch 40, row 144 wide)
 *     and the social row still occupies only the comp's 24px of height.
 *     40 rather than 44 wide is deliberate: 44 forced a 44px pitch and pushed
 *     the last social mark 12px past the comp. 40 × 44 is still well over the
 *     WCAG 2.5.8 minimum (24 × 24), and the four boxes tile with no dead gap
 *     between them, so nothing is harder to hit than it was.
 *
 *  2b. SITEMAP BLOCK IS 640 / 1174 = 54.5145%, NOT A HARD 640px. The comp's
 *     640 + 534 split only adds up when the content column is the full 1174,
 *     which `container-site` reaches at 1366 and above. Pinning 640px from
 *     `lg` starved the subscribe block to 288px at 1024 and reflowed the
 *     consent line to five lines. As a percentage it resolves to exactly
 *     640 / 534 at the design width and stays in proportion below it.
 *  3. DOM ORDER IS NEVER REORDERED. The comp puts the sitemap left and the
 *     subscribe block right; stacked, the sitemap comes first. It is tempting
 *     to float subscribe to the top on mobile, but doing it in CSS would
 *     divorce the visual order from the tab order. If the client wants
 *     subscribe first on mobile, we change the source order for every size.
 *  4. LEGAL BAR STACKS BELOW `md`: copyright first, then the legal links,
 *     left-aligned, 16px apart. It grows from 72px to roughly 112px.
 *  5. THE LOCKUP IS NOT SCALED. 279.8 × 40 clears a 375px viewport with 24px
 *     gutters, so shrinking it would only cost legibility.
 *  6. VERTICAL RHYTHM STEPS DOWN: top padding 96 → 64 (md) → 48 (base), root
 *     gap 64 → 48, matching the container gutters that `container-site`
 *     already steps at the same breakpoints.
 *
 * STATES WE INVENTED (the comp draws default states only, spec §9):
 *  - links underline on hover, icons fade to text-inactive
 *  - the input's rule goes solid white on focus-within, on top of the global
 *    white :focus-visible ring that `.on-dark` supplies
 *  - success / error / not-yet-connected messaging renders into a live region
 *    under the input; the comp has no slot for it, so the row is free to grow
 */
import Container from "@primitives/Container.astro";
import Overline from "@primitives/Overline.astro";
import { b2blead } from "@content/integrations";
import type { ImageRef, SiteFooter } from "@content/types";
import {
  footer as footerContent,
  footerLogo,
  newsletterMessages,
  NEWSLETTER_ENDPOINT,
  type NewsletterMessages,
} from "@content/footer";

interface Props {
  /** Defaults to the global singleton so the footer can be dropped in bare. */
  footer?: SiteFooter;
  logo?: ImageRef;
  messages?: NewsletterMessages;
  class?: string;
}

const {
  footer = footerContent,
  logo = footerLogo,
  messages = newsletterMessages,
  class: className = "",
} = Astro.props;

const { columns, newsletter, social, legalLinks, copyright } = footer;

/**
 * Dynamic copyright year. The design hardcodes 2026 and the live site still
 * says 2024, so the content module stores a `{year}` token instead. The build
 * year is rendered server-side (correct with JavaScript disabled) and a three
 * line script re-checks it in the browser, so a static build that sits through
 * New Year's Eve does not go stale.
 */
const copyrightParts = copyright.split("{year}");
const hasYearToken = copyrightParts.length > 1;
const copyrightBefore = copyrightParts[0] ?? copyright;
const copyrightAfter = hasYearToken ? copyrightParts.slice(1).join("{year}") : "";
const buildYear = String(new Date().getFullYear());

/**
 * Social marks, inlined so they inherit currentColor for hover states rather
 * than shipping six separate monochrome files (Figma spec §4).
 * `box` is the glyph's own leaf size: Messenger is drawn 18 × 18 inside its
 * 24px slot and must keep that inset rather than being stretched.
 * TODO(assets): these paths are transcribed from the Figma exports; re-check
 * them against the real export when the icon set is delivered.
 */
const socialIcons: Record<string, { box: number; d: string }> = {
  instagram: {
    box: 24,
