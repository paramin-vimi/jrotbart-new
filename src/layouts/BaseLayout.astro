---
import "@/styles/global.css";
import type { Seo } from "@content/types";
import { b2blead, gleap } from "@content/integrations";
import BackToTop from "@components/BackToTop.astro";

interface Props {
  seo: Seo;
  /** JSON-LD graph for this page, built with lib/schema.ts */
  schema?: object;
  /**
   * Classes for <main>. SiteLayout uses it for the fixed-header clearance so
   * page blocks stay direct children of <main> (`main > section` is what
   * scripts/shoot.mjs captures and what the seam CSS's sibling selectors see).
   * Absent = no class attribute, exactly as before.
   */
  mainClass?: string;
}

const { seo, schema, mainClass } = Astro.props;

// Preview builds (GitHub Pages) are never indexable, whatever an individual
// page asked for. PREVIEW_BUILD is a compile-time boolean injected by
// astro.config.mjs; in production Vite substitutes the literal `false`, so
// `noindex` collapses to exactly `seo.noindex` and the emitted HTML is
// unchanged. BaseLayout is a complete chokepoint — all seven files in
// src/pages/ import it — so this one line reaches every page, present and
// future, which is why it lives here rather than in each page module.
const previewBuild = import.meta.env.PREVIEW_BUILD === true;
const noindex = previewBuild || seo.noindex;

const canonical = seo.canonical ?? new URL(Astro.url.pathname, Astro.site).href;

/*
  `new URL(src, Astro.site)` resolves against the ORIGIN only — `Astro.site` is
  "https://jrotbart.com", it carries no base path — so under a subpath preview
  every share card pointed at /og-default.jpg on the bare github.io host rather
  than at /<repo>/og-default.jpg, and 404'd. BASE_URL is the one thing that
  carries the base, so the join goes through it. At the production base of "/"
  the trim makes this byte-identical to what it replaced.
*/
const withBase = (p: string) =>
  new URL(import.meta.env.BASE_URL.replace(/\/$/, "") + p, Astro.site).href;

const ogImage = withBase(seo.ogImage?.src ?? "/og-default.jpg");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {/* "noindex, follow" is deliberate, and deliberately NOT "nofollow".
        `follow` lets a crawler walk from whatever entry URL it found to every
        other page, so each one is fetched and each one gets its own explicit
        noindex. `nofollow` would leave the rest un-crawled, and un-crawled URLs
        are precisely the ones that later get URL-only-indexed from a stray
        inbound link — it makes the failure mode more likely, not less. Link
        equity is moot on a page that is not in the index. This line is also
        shared with the production per-post Sanity noindex flag, so changing the
        string would change production output. */}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="J. Rotbart & Co." />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#81161a" />

    {/* Favicons, generated from the crown mark in the Figma logo lockup
        (Group 9643). The live site ships JPEG favicons, which is why they
        render with artefacts; these are a proper SVG + PNG + ICO set. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Preview builds publish no sitemap, so they must not advertise one —
        see the integrations line in astro.config.mjs. */}
    {!previewBuild && <link rel="sitemap" href="/sitemap-index.xml" />}

    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema)}
      />
    )}

    {/* Gleap feedback widget. Last in <head>, per the vendor's instruction to
        place it before </head>; `is:inline` keeps the snippet verbatim rather
        than letting the bundler touch it.
        TODO(client): a third-party script that can set cookies, record sessions
        and capture screenshots — see the privacy note in
        src/content/integrations.ts. It needs gating behind the consent layer
        this site does not have yet. */}
    <script is:inline set:html={gleap.snippet} />

    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="sr-only-focusable bg-always-white text-text-primary px-4 py-2 border border-border-primary">
      Skip to main content
    </a>

    <slot name="header" />

    <main id="main" {...(mainClass ? { class: mainClass } : {})}>
      <slot />
    </main>

    <slot name="footer" />

    <BackToTop />

    {/* b2blead site-wide deployment (the AI chat agent). Loaded on every page,
        async and last so it never blocks render.
        TODO(client): this is an unconsented third-party script — see the
        privacy note in src/content/integrations.ts. */}
    <script is:inline src={b2blead.deploymentScript} async></script>
  </body>
</html>
