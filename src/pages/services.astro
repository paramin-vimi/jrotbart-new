---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageHero from "@sections/PageHero.astro";
import FeatureGrid from "@sections/FeatureGrid.astro";
import CtaBand from "@sections/CtaBand.astro";
import TestimonialBand from "@sections/TestimonialBand.astro";

import {
  seo as pageSeo,
  breadcrumb,
  servicesHero,
  serviceGrid,
  consultationBand,
  testimonial,
} from "@content/pages/services";

import { buildGraph, siteGraph, webPageNode, breadcrumbNode, itemListNode, SITE } from "@lib/schema";

/**
 * Service listing — /services/.
 *
 * Section order follows the Figma frame `Service - Listing` (10976:21516) top
 * to bottom. Each section is a block from the fixed union in
 * src/content/types.ts, assembled in src/content/pages/services.ts — this
 * page composes, it does not contain content or layout of its own. The tail
 * (mint strip + contact section) comes from SiteLayout.
 */

const url = `${SITE}/services/`;
const seo = { ...pageSeo, canonical: url };

/* The ItemList is the ten services in the order the grid shows them, derived
   from the rendered cells so it cannot drift from the page. Two of the ten have
   no page of their own yet and point at the enquiry form; they are still listed,
   because the list describes what this page offers, not what is routable. */
const listedServices = serviceGrid.cells.map((cell) => ({
  name: cell.title,
  href: cell.link?.href ?? "#contact",
}));

const schema = buildGraph([
  ...siteGraph(),
  webPageNode(seo, url),
  breadcrumbNode(breadcrumb.map((crumb) => ({ name: crumb.label, url: `${SITE}${crumb.href}` }))),
  itemListNode(
    url,
    listedServices.map((service) => ({
      name: service.name,
      // A "#contact" href is this page plus a fragment, never a bare fragment.
      url: service.href.startsWith("#") ? `${url}${service.href}` : `${SITE}${service.href}`,
    })),
  ),
]);
---

<SiteLayout seo={seo} schema={schema} currentSection="services">
  {/* Figma draws this frame's text column 454 wide (10976:21520), against
      the 530 the Office listing uses — a measure, not copy, so it is passed
      here rather than authored in the content module. */}
  <PageHero block={servicesHero} columnClass="max-w-[454px]" />

  {/* The ten services as one two-column grid of icon cells (10977:23256).
      Figma types the cell titles at 16/24, which is `titleSize="h4"`. */}
  <FeatureGrid block={serviceGrid} titleSize="h4" />

  <CtaBand block={consultationBand} />

  <TestimonialBand block={testimonial} />
</SiteLayout>
