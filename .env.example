# Copy to .env and fill in. NEVER commit .env.

# ---- Sanity (blog posts only) -------------------------------------------
# From `sanity init` in ./studio, or the project page at sanity.io/manage.
# PUBLIC_* vars are inlined into the build; that is fine — a Sanity project ID
# and dataset name are public identifiers, not secrets.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional. Only needed to preview unpublished drafts at build time.
# This one IS a secret.
SANITY_API_READ_TOKEN=

# ---- Contact form -> HubSpot (portal 7115897) ---------------------------
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Cloudflare Turnstile (replaces reCAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Newsletter destination — the current Mailjet endpoint 404s and has been
# silently discarding signups. Decide: repair Mailjet, or move to HubSpot.
NEWSLETTER_ENDPOINT=
